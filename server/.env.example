# Copy to server/.env and adjust values (never commit server/.env).

# Use 5001 on macOS if port 5000 is taken by AirPlay Receiver
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
